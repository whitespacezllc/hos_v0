# Supabase — get these from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — keep this server-side only, never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin JWT secret — used by is_admin() RLS helper to verify admin sessions
# Must match the secret used when signing admin JWTs
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Resend — booking confirmations, pack codes and the studio's heads-up
# (https://resend.com/api-keys). Optional in development: if unset, bookings
# still go through and pack codes can be resent from the admin later.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender for every outgoing email. In production this MUST be an address on a
# domain verified in Resend (Domains → Add domain → DNS records), e.g.
# "House of Shakti <hello@houseofshakticr.com>". Resend's onboarding sender
# below only delivers to the Resend account's own address — fine for testing,
# useless for customers.
EMAIL_FROM=House of Shakti <onboarding@resend.dev>
# Optional: where the studio hears about every new booking and every cash /
# Venmo payment waiting to be collected. One address, or several with commas.
BOOKING_NOTIFY_EMAIL=

# Tilopay — payment gateway (Costa Rica) for class-pack checkout.
# Get these from the Tilopay admin: Configuración → API / Integración.
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
# Public base URL used to build the payment return/callback URL and the links
# in emails. Production falls back to https://houseofshakticr.com when unset;
# set it explicitly anyway.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Venmo handle shown to customers who choose to pay a class/pack by Venmo.
# Public (just a username). Defaults to "@Nancy-Goodfellow" if unset.
NEXT_PUBLIC_VENMO_HANDLE=@Nancy-Goodfellow
# Every approved return from Tilopay is verified against their API (consult)
# before a booking is confirmed or a pack code issued. Set this to "true" ONLY
# in an emergency to believe the return as-is (no verification at all).
TILOPAY_TRUST_CALLBACK=false

# Google Search Console — the meta-tag verification token for
# houseofshaktiyoga.com. Optional: when unset, no verification tag is rendered.
NEXT_PUBLIC_GSC_VERIFICATION=
